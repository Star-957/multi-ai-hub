# Copy this file to .env. Configure only the providers you intend to use.
# Never put keys in public/ or in browser-side configuration.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Example model IDs; check availability with your provider before use.
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
# Built-in OpenAI image generation is advertised to agents ONLY when this is "true".
# Disabled by default to avoid unrequested image-generation costs.
OPENAI_IMAGE_ENABLED=false
ANTHROPIC_MODEL=claude-opus-4-8
CLAUDE_TRANSPORT=cli
CLAUDE_EFFORT=max
GEMINI_MODEL=gemini-3.5-flash
# Local seats require a loopback origin; remote endpoints and redirects are refused.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
# Fast local sanity seat (ask_llama_fast). Download the chosen model separately.
# Change to llama3.2:latest only if you have actually pulled it (`ollama pull llama3.2`).
OLLAMA_FAST_MODEL=qwen3:8b
OLLAMA_DEEPSEEK_MODEL=deepseek-r1:70b

# Optional council seats. They stay dormant until the matching API key is set.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GLM_API_KEY=
GLM_MODEL=glm-5.2
# NVIDIA NIM — optional OpenAI-compatible cloud seat; check current pricing and limits.
# Dormant until NVIDIA_API_KEY is set; then ask_nvidia registers and it joins the quick council.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Loopback only. Other addresses (including 0.0.0.0) are rejected.
# HOST supports 127.0.0.1, localhost, or ::1. PORT must be 1..65535.
# Public hosting uses pnpm build:demo instead of this server.
HOST=127.0.0.1
PORT=8787
MAX_DELEGATION_DEPTH=3
MAX_TOOL_ROUNDS=6
MAX_OUTPUT_TOKENS=4096
